# Include in the SAME HTTPS virtual host that serves the Flutter Web app.
# Replace the canonical origin/host and install your TLS certificate normally.
# http {} prerequisite:
# limit_req_zone $binary_remote_addr zone=identity:10m rate=5r/s;

location ^~ /api/identity/ {
    limit_req zone=identity burst=20 nodelay;
    client_max_body_size 64k;
    client_body_timeout 10s;
    proxy_pass http://127.0.0.1:8787;
    proxy_set_header Host board.example.invalid;
    proxy_set_header X-Forwarded-Proto "";
    proxy_set_header X-Forwarded-Host "";
    proxy_set_header X-Forwarded-For "";
    proxy_connect_timeout 2s;
    proxy_read_timeout 15s;
    proxy_send_timeout 15s;
    proxy_buffering off;
    proxy_cache off;
    access_log off;
    error_log /dev/null crit;
}

location = /auth/callback {
    limit_req zone=identity burst=20 nodelay;
    client_max_body_size 1k;
    proxy_pass http://127.0.0.1:8787;
    proxy_set_header Host board.example.invalid;
    proxy_set_header X-Forwarded-Proto "";
    proxy_set_header X-Forwarded-Host "";
    proxy_set_header X-Forwarded-For "";
    proxy_connect_timeout 2s;
    proxy_read_timeout 15s;
    proxy_send_timeout 15s;
    proxy_buffering off;
    proxy_cache off;
    # OAuth codes must not enter URI logs, analytics, tracing or shared caches.
    access_log off;
    error_log /dev/null crit;
}
