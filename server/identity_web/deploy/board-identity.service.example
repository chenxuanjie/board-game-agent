[Unit]
Description=Board game Web identity session service
After=network.target

[Service]
Type=simple
User=board-identity
Group=board-identity
WorkingDirectory=/opt/board-game-agent/server/identity_web
EnvironmentFile=/etc/board-identity/private.env
ExecStart=/opt/node24/bin/node src/main.js
Restart=on-failure
RestartSec=5
TimeoutStopSec=45
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
StateDirectory=board-identity
ReadWritePaths=/var/lib/board-identity

[Install]
WantedBy=multi-user.target
