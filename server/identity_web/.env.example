# Copy to a PRIVATE file outside the web root; restrict to the service account.
# Registration pins below are operator-reviewed values, not client settings.
PUBLIC_WEB_ORIGIN=https://board.example.invalid
SUPABASE_URL=https://project-ref.supabase.co
REGISTERED_SUPABASE_URL=https://project-ref.supabase.co
# A publishable key OR an operator-registered legacy JWT key whose role is anon.
# Never supply sb_secret_ or service_role. The exact-byte SHA256 pin is mandatory.
SUPABASE_PUBLISHABLE_KEY=REPLACE_SUPABASE_PUBLISHABLE_OR_LEGACY_ANON_KEY
REGISTERED_SUPABASE_KEY_SHA256=REPLACE_LOWERCASE_SHA256_OF_EXACT_PUBLISHABLE_KEY
REGISTERED_CALLBACK_URL=https://board.example.invalid/auth/callback
SESSION_ENCRYPTION_KEY=REPLACE_BASE64_32_RANDOM_BYTES
SESSION_DB_PATH=/var/lib/board-identity/sessions.sqlite
PORT=8787
SESSION_IDLE_SECONDS=1800
SESSION_ABSOLUTE_SECONDS=86400
REQUEST_TIMEOUT_MS=10000
MAX_SESSIONS=10000
# Optional: an exact, trusted endpoint enforcing the Supabase user's sub/RLS.
# USERDATA_UPSTREAM_URL=https://userdata.example.invalid/userdata
# REGISTERED_USERDATA_UPSTREAM_URL=https://userdata.example.invalid/userdata
