# Private service configuration: keep outside the Web root and Git.
# Serve Flutter Web and /api/identity/ on this SAME HTTPS origin.
PUBLIC_WEB_ORIGIN=https://board.example.invalid
SYNOLOGY_ORIGIN=https://cznas.dpdns.org:5001
# Generate once; never regenerate on restart or ordinary upgrade.
NAS_INSTANCE_ID=REPLACE_WITH_RANDOM_STABLE_NAS_ID
SESSION_ENCRYPTION_KEY=REPLACE_BASE64_32_RANDOM_BYTES
SESSION_DB_PATH=/var/lib/board-identity/synology-sessions.sqlite
PORT=8787
SESSION_IDLE_SECONDS=1800
SESSION_ABSOLUTE_SECONDS=86400
REQUEST_TIMEOUT_MS=15000
MAX_SESSIONS=10000
# No user password, DSM administrator token, Supabase key or OIDC secret here.
