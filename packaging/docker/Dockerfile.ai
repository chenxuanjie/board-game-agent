FROM python:3.13-slim
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1
WORKDIR /app
COPY services/web_account/requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt
COPY services/web_account/ai_app.py services/web_account/ai_proxy.py ./
USER 65532:65532
EXPOSE 8000
CMD ["uvicorn", "ai_app:create_app", "--factory", "--host", "0.0.0.0", "--port", "8000", "--workers", "1", "--no-access-log", "--no-proxy-headers"]
