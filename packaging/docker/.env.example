WEB_PORT=8887
ACCOUNT_SHARED_FOLDER=friend
IMAGE_TAG=local
# Same architecture as the existing USV x86-64 executable. Image bundles pin
# both this value and IMAGE_TAG to the exact build they contain.
BGA_IMAGE_PLATFORM=linux/amd64
# Numeric identity of the existing NAS library owner, verified read-only via DSM.
# Applies to both Python and Nginx, without changing any NAS ACL or ownership.
NAS_READER_UID=1028
NAS_READER_GID=100
# Existing host folder containing assets/catalog.json. Mounted read-only.
LIBRARY_PATH=/volume2/friend/apps/board_game_agent/board-game-lib
# The SAME folder as seen in DSM FileStation (without /volume2).
LIBRARY_NAS_PATH=/friend/apps/board_game_agent/board-game-lib
# Trusted DSM address. Credentials are entered by each user, never configured here.
SYNOLOGY_ORIGIN=https://cznas.pp.ua:5001
SYNOLOGY_HOST=cznas.pp.ua
SYNOLOGY_LAN_IP=192.168.1.55
COMMENTS_PATH=/volume2/friend/apps/board_game_agent_comments/public/v1
# Legacy identity namespace retained by the native app. This is NOT a network target.
SYNOLOGY_IDENTITY_ORIGIN=https://cznas.dpdns.org:5001
# The exact origin shown in the browser, without a trailing path.
WEB_PUBLIC_ORIGIN=http://cznas.pp.ua:8887
# Direct HTTP entry on 8887. Use false when changing the site to HTTPS.
WEB_ALLOW_INSECURE_HTTP=true
