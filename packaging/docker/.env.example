WEB_PORT=8887
IMAGE_TAG=local
# Trusted DSM address. Credentials are entered by each user, never configured here.
SYNOLOGY_ORIGIN=https://nas.example:5001
# Keep the same canonical origin used by the native app for matching account IDs.
SYNOLOGY_IDENTITY_ORIGIN=https://nas.example:5001
# The exact origin shown in the browser, without a trailing path.
WEB_PUBLIC_ORIGIN=https://board-games.example
# Local HTTP testing only; production sessions use Secure cookies over HTTPS.
WEB_ALLOW_INSECURE_HTTP=false
